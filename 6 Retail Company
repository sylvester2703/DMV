# 1. Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
# 2. Load the retail sales dataset
df = pd.read_csv(r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\DMV\Retail_Sales_Data.csv")
# 3. Explore the dataset
print("DATASET LOADED SUCCESSFULLY")
print("\nFirst five rows:")
print(df.head())
print("\nDataset shape:", df.shape)
print("\nColumn names:", df.columns.tolist())
print("\nDataset information:")
df.info()
print("\nStatistical summary:")
print(df.describe(include="all"))
print("\nMissing values:")
print(df.isnull().sum())
print("\nDuplicate records:", df.duplicated().sum())
# 4. Standardize text and identify relevant columns
for col in ["State", "Shop_Category"]:
    df[col] = df[col].map(
        lambda x: x.strip() if isinstance(x, str) else x
    )
print("\nAvailable regions:")
print(sorted(df["State"].dropna().unique()))
print("\nAvailable shop categories:")
print(sorted(df["Shop_Category"].dropna().unique()))
# 5. Convert sales amounts to numeric values
df["Sales"] = pd.to_numeric(df["Sales"], errors="coerce")
# 6. Remove incomplete and invalid sales records
df = df.dropna(subset=["State", "Shop_Category", "Sales"]).copy()
df = df[df["Sales"] >= 0].copy()
df.drop_duplicates(inplace=True)
df.reset_index(drop=True, inplace=True)
print("\nDataset shape after cleaning:", df.shape)
print("Missing values in selected columns:",
      df[["State", "Shop_Category", "Sales"]].isnull().sum().sum())
# 7. Calculate total sales for each region
regional_sales = (
    df.groupby("State")["Sales"]
    .sum()
    .sort_values(ascending=False)
)
print("\nTotal sales by region:")
print(regional_sales)
# 8. Plot total sales by region
plt.figure(figsize=(10, 6))
plt.bar(regional_sales.index, regional_sales.values, label="Total Sales")
plt.title("Total Sales by Region")
plt.xlabel("Region (State)")
plt.ylabel("Total Sales Amount")
plt.legend()
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()
# 9. Visualize the percentage distribution of sales by region
plt.figure(figsize=(8, 8))
plt.pie(
    regional_sales.values,
    labels=regional_sales.index,
    autopct="%1.1f%%",
    startangle=90
)
plt.title("Percentage Distribution of Sales by Region")
plt.axis("equal")
plt.show()
# 10. Identify the top-performing region
top_region = regional_sales.idxmax()
top_sales = regional_sales.max()
print("\nTop-performing region:")
print("Region:", top_region)
print("Total Sales:", top_sales)
print("\nTop three regions by sales:")
print(regional_sales.head(3))
# 11. Aggregate sales by region and shop category
region_category_sales = (
    df.groupby(["State", "Shop_Category"])["Sales"]
    .sum()
    .sort_values(ascending=False)
)
print("\nTotal sales by region and shop category:")
print(region_category_sales)
# 12. Convert aggregated data into a pivot table for plotting
sales_pivot = (
    df.pivot_table(
        index="State",
        columns="Shop_Category",
        values="Sales",
        aggfunc="sum",
        fill_value=0,
        observed=False
    )
)
print("\nRegion-category sales table:")
print(sales_pivot)
# 13. Plot stacked sales by region and category
sales_pivot.plot(
    kind="bar",
    stacked=True,
    figsize=(12, 6)
)
plt.title("Sales by Region and Shop Category")
plt.xlabel("Region (State)")
plt.ylabel("Total Sales Amount")
plt.legend(
    title="Shop Category",
    bbox_to_anchor=(1.05, 1),
    loc="upper left"
)
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()
# 14. Plot grouped sales for category comparison
sales_pivot.plot(
    kind="bar",
    stacked=False,
    figsize=(12, 6)
)
plt.title("Comparison of Shop Category Sales Across Regions")
plt.xlabel("Region (State)")
plt.ylabel("Total Sales Amount")
plt.legend(
    title="Shop Category",
    bbox_to_anchor=(1.05, 1),
    loc="upper left"
)
plt.grid(axis="y", alpha=0.3)
plt.tight_layout()
plt.show()
# 15. Display the final sales summary
print("\n========== FINAL SALES SUMMARY ==========")
print("Total Sales:", df["Sales"].sum())
print("Number of Regions:", df["State"].nunique())
print("Number of Shop Categories:", df["Shop_Category"].nunique())
print("Top-performing Region:", top_region)
print("Top Region Sales:", top_sales)
print("Average Transaction Sales:", round(df["Sales"].mean(), 2))
print("=========================================")
