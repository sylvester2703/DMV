# Algorithm Step 1: Import libraries and load CSV, Excel and JSON files
import pandas as pd
import matplotlib.pyplot as plt
import os
csv_df = pd.read_csv(r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\DMV\sales_data.csv")
excel_df = pd.read_excel(r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\DMV\sales_data.xlsx")
json_df = pd.read_json(r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\DMV\sales_data.json")
datasets = {"CSV": csv_df, "Excel": excel_df, "JSON": json_df}
print("DATA LOADING COMPLETED")
# Algorithm Step 2: Explore each dataset
for name, data in datasets.items():
    print("\n" + "=" * 40)
    print(name, "DATA")
    print("=" * 40)
    print("\nFirst five records:\n", data.head())
    print("\nDataset dimensions:", data.shape)
    print("\nColumn names:", data.columns.tolist())
    print("\nData types:\n", data.dtypes)
    print("\nMissing values:\n", data.isnull().sum())
    print("\nDuplicate rows:", data.duplicated().sum())
# Algorithm Step 3: Standardize column names and combine datasets
# Handle common variations in column names across different files
def standardize_columns(data):
    data = data.copy()
    data.columns = data.columns.str.strip()
    rename_map = {
        "Order_ID": "OrderID",
        "Order Id": "OrderID",
        "Date": "OrderDate",
        "Order_Date": "OrderDate",
        "Price": "UnitPrice",
        "Unit Price": "UnitPrice"
    }
    return data.rename(columns=rename_map)
datasets = {
    name: standardize_columns(data)
    for name, data in datasets.items()
}
df = pd.concat(datasets.values(), ignore_index=True)
print("\nCombined shape before cleaning:", df.shape)
# Algorithm Step 4: Remove empty rows and duplicate records
df.columns = df.columns.str.strip()
df.dropna(how="all", inplace=True)
df.drop_duplicates(inplace=True)
# Check whether the essential columns are available
required_columns = ["OrderID", "OrderDate", "Product",
                    "Category", "Quantity", "UnitPrice", "Region"]
missing_columns = [col for col in required_columns if col not in df.columns]
if missing_columns:
    raise ValueError(
        f"Required columns missing: {missing_columns}. "
        f"Available columns: {df.columns.tolist()}"
    )
# Standardize text columns that actually exist
text_columns = [
    col for col in ["Product", "Category", "Region",
                    "Customer", "PaymentMethod"]
    if col in df.columns
]
for col in text_columns:
    df[col] = df[col].astype("string").str.strip().str.title()
    df[col] = df[col].replace(r"^\s*$", pd.NA, regex=True)
# Convert numeric columns to valid numeric values
for col in ["Quantity", "UnitPrice"]:
    df[col] = pd.to_numeric(df[col], errors="coerce")
# Convert dates into a consistent datetime format
df["OrderDate"] = pd.to_datetime(df["OrderDate"], errors="coerce")
# Fill missing numeric values using the median
for col in ["Quantity", "UnitPrice"]:
    if df[col].notna().any():
        df[col] = df[col].fillna(df[col].median())
# Fill missing text values using the most frequent value
for col in text_columns:
    if df[col].notna().any():
        df[col] = df[col].fillna(df[col].mode()[0])
# Remove records with missing order IDs or invalid dates
df.dropna(subset=["OrderID", "OrderDate"], inplace=True)
# Convert Quantity to integer if all values are whole numbers
if df["Quantity"].notna().all() and (df["Quantity"] % 1 == 0).all():
    df["Quantity"] = df["Quantity"].astype("int64")
# Algorithm Step 5: Calculate sales for each order
df["Sales"] = df["Quantity"] * df["UnitPrice"]
print("\n" + "=" * 40)
print("CLEANED AND UNIFIED SALES DATA")
print("=" * 40)
print("\nFirst five records:\n", df.head())
print("\nDataset information:")
df.info()
print("\nStatistical summary:\n", df.describe(include="all"))
print("\nMissing values after cleaning:\n", df.isnull().sum())
print("\nDuplicate rows after cleaning:", df.duplicated().sum())
# Algorithm Step 6: Calculate total sales and group sales by product and region
print("\nTotal Sales:", round(df["Sales"].sum(), 2))

product_sales = df.groupby("Product")["Sales"].sum().sort_values(
    ascending=False
)
region_sales = df.groupby("Region")["Sales"].sum().sort_values(
    ascending=False
)
print("\nSales by Product:\n", product_sales)
print("\nSales by Region:\n", region_sales)
# Algorithm Step 7: Visualize sales by product and region
product_sales.plot(
    kind="bar", title="Sales by Product",
    xlabel="Product", ylabel="Total Sales"
)
plt.tight_layout()
plt.show()
region_sales.plot(
    kind="bar", title="Sales by Region",
    xlabel="Region", ylabel="Total Sales"
)
plt.tight_layout()
plt.show()
# Algorithm Step 8: Save the cleaned dataset as a CSV file
# Saves in the current Jupyter Notebook working directory
output_file = os.path.abspath("cleaned_sales_data.csv")
df.to_csv(output_file, index=False)
print("\nFinal dataset shape:", df.shape)
print("Unified dataset saved to:", output_file)
