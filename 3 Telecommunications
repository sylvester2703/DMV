#3 Analyzing Customer Churn in a Telecommunications Company
# ============================================================
# DATA CLEANING AND PREPARATION: CUSTOMER CHURN
# ============================================================

import os
import pandas as pd
import numpy as np

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

# ============================================================
# STEP 1: LOAD DATASET
# ============================================================

folder = r"D:\B.E. practicals\TelecomChurn"
file_path = os.path.join(folder, "Telecom_Customer_Churn.csv")

df = pd.read_csv(file_path)

print("DATASET LOADED SUCCESSFULLY")
print("\nFirst five records:\n", df.head())
print("\nDataset shape:", df.shape)
print("\nColumn names:\n", df.columns.tolist())
print("\nData types:\n", df.dtypes)
print("\nMissing values:\n", df.isnull().sum())
print("\nDuplicate records:", df.duplicated().sum())
print("\nStatistical summary:\n", df.describe(include="all"))

# ============================================================
# STEP 2: REMOVE DUPLICATE RECORDS
# ============================================================

df.drop_duplicates(inplace=True)
df.reset_index(drop=True, inplace=True)

print("\nDuplicates after removal:", df.duplicated().sum())

# ============================================================
# STEP 3: STANDARDIZE COLUMN NAMES AND TEXT
# ============================================================

df.columns = df.columns.str.strip()

# Clean whitespace in text columns
for col in df.select_dtypes(include="object").columns:
    df[col] = df[col].str.strip()

# Standardize capitalization
text_columns = [
    "gender", "Partner", "Dependents", "PhoneService",
    "InternetService", "Contract", "PaymentMethod", "Churn"
]

for col in text_columns:
    if col in df.columns:
        df[col] = df[col].str.lower()

# Standardize known variations
df["Contract"] = df["Contract"].replace({
    "month to month": "month-to-month",
    "month-to-month ": "month-to-month"
})

# ============================================================
# STEP 4: CONVERT DATA TYPES
# ============================================================

numeric_columns = [
    "SeniorCitizen", "tenure", "MonthlyCharges", "TotalCharges"
]

for col in numeric_columns:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")

print("\nData types after conversion:\n", df.dtypes)

# ============================================================
# STEP 5: HANDLE MISSING VALUES
# ============================================================

print("\nMissing values before treatment:\n", df.isnull().sum())

# Remove rows without a usable target label
df["Churn"] = df["Churn"].replace("", np.nan)
df.dropna(subset=["Churn"], inplace=True)

# Fill numerical missing values with medians
for col in df.select_dtypes(include=np.number).columns:
    if df[col].notna().any():
        df[col] = df[col].fillna(df[col].median())

# Fill categorical missing values with modes
for col in df.select_dtypes(include="object").columns:
    if df[col].notna().any():
        df[col] = df[col].fillna(df[col].mode()[0])

print("\nMissing values after treatment:\n", df.isnull().sum())

# ============================================================
# STEP 6: IDENTIFY AND HANDLE OUTLIERS
# ============================================================

outlier_columns = ["tenure", "MonthlyCharges", "TotalCharges"]

print("\nOutliers detected using IQR:")

for col in outlier_columns:
    q1 = df[col].quantile(0.25)
    q3 = df[col].quantile(0.75)
    iqr = q3 - q1

    lower_limit = q1 - 1.5 * iqr
    upper_limit = q3 + 1.5 * iqr

    count = ((df[col] < lower_limit) |
             (df[col] > upper_limit)).sum()

    print(f"{col}: {count}")

    # Cap outliers instead of deleting customer records
    df[col] = df[col].clip(
        lower=lower_limit,
        upper=upper_limit
    )

# ============================================================
# STEP 7: FEATURE ENGINEERING
# ============================================================

# Categorize customers based on tenure
df["TenureGroup"] = pd.cut(
    df["tenure"],
    bins=[-1, 12, 24, 48, float("inf")],
    labels=["New", "Medium", "Long", "Loyal"]
)

# Average monthly charge based on total charges and tenure
df["AverageCharge"] = (
    df["TotalCharges"] /
    df["tenure"].replace(0, np.nan)
)

df["AverageCharge"] = df["AverageCharge"].fillna(
    df["MonthlyCharges"]
)

# Total charges per month relative to monthly charges
df["ChargeDifference"] = (
    df["TotalCharges"] -
    df["MonthlyCharges"] * df["tenure"]
)

print("\nNew features created:")
print(df[[
    "tenure", "TenureGroup",
    "AverageCharge", "ChargeDifference"
]].head())

# ============================================================
# STEP 8: EXPORT CLEANED DATASET
# ============================================================

cleaned_path = os.path.join(folder, "cleaned_churn.csv")
df.to_csv(cleaned_path, index=False)

print("\nCleaned dataset saved:", cleaned_path)

# ============================================================
# STEP 9: PREPARE FEATURES AND TARGET
# ============================================================

# CustomerID is an identifier, not a predictive feature
X = df.drop(columns=["Churn", "customerID"], errors="ignore")

# Convert churn to binary target
y = df["Churn"].map({"no": 0, "yes": 1})

# Remove rows if the target could not be mapped
valid = y.notna()
X = X.loc[valid]
y = y.loc[valid].astype(int)

# One-hot encode categorical features
X = pd.get_dummies(
    X,
    drop_first=True,
    dtype=int
)

# ============================================================
# STEP 10: SPLIT INTO TRAINING AND TESTING SETS
# ============================================================

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y
)

print("\nTraining samples:", X_train.shape[0])
print("Testing samples:", X_test.shape[0])
print("Training feature count:", X_train.shape[1])
print("Testing feature count:", X_test.shape[1])

# ============================================================
# STEP 11: SCALE NUMERICAL FEATURES
# ============================================================

# Scale only continuous numerical features.
# Binary encoded columns and the target remain unchanged.

scale_columns = [
    col for col in [
        "tenure", "MonthlyCharges", "TotalCharges",
        "AverageCharge", "ChargeDifference"
    ] if col in X_train.columns
]

scaler = StandardScaler()

X_train = X_train.copy()
X_test = X_test.copy()

X_train.loc[:, scale_columns] = scaler.fit_transform(
    X_train[scale_columns]
)

X_test.loc[:, scale_columns] = scaler.transform(
    X_test[scale_columns]
)

# ============================================================
# STEP 12: EXPORT TRAINING AND TESTING DATA
# ============================================================

train_df = X_train.copy()
train_df["Churn"] = y_train

test_df = X_test.copy()
test_df["Churn"] = y_test

train_path = os.path.join(folder, "train_data.csv")
test_path = os.path.join(folder, "test_data.csv")

train_df.to_csv(train_path, index=False)
test_df.to_csv(test_path, index=False)

# ============================================================
# STEP 13: FINAL VALIDATION
# ============================================================

print("\nFINAL RESULTS")
print("-" * 40)

print("Cleaned dataset shape:", df.shape)
print("Training dataset shape:", train_df.shape)
print("Testing dataset shape:", test_df.shape)

print("\nMissing values in cleaned dataset:",
      df.isnull().sum().sum())

print("Duplicate records in cleaned dataset:",
      df.duplicated().sum())

print("\nChurn distribution:")
print(df["Churn"].value_counts())

print("\nAll output files saved in:", folder)
print("1. cleaned_churn.csv")
print("2. train_data.csv")
print("3. test_data.csv")
