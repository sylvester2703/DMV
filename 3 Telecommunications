# Algorithm Step 1: Import required libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import os
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
# Algorithm Step 2: Load the dataset
df = pd.read_csv(r"C:\Users\Dell\OneDrive\Desktop\BE_Datasets\DMV\telecom_customer_churn.csv")
print("DATASET LOADED SUCCESSFULLY")
print("\nFirst five records:\n", df.head())
print("\nDataset shape:", df.shape)
print("\nColumn names:\n", df.columns.tolist())
print("\nData types:\n", df.dtypes)
print("\nMissing values:\n", df.isnull().sum())
print("\nDuplicate records:", df.duplicated().sum())
print("\nStatistical summary:\n", df.describe(include="all"))
# Algorithm Step 3: Standardize column names and text values
df.columns = df.columns.str.strip()
# Remove leading/trailing spaces and standardize text to lowercase
for col in df.select_dtypes(include=["object"]).columns:
    df[col] = df[col].map(
        lambda x: x.strip().lower() if isinstance(x, str) else x
    )
# Algorithm Step 4: Remove duplicate records
df.drop_duplicates(inplace=True)
df.reset_index(drop=True, inplace=True)
print("\nDuplicate records after removal:", df.duplicated().sum())
# Algorithm Step 5: Convert numeric columns to appropriate data types
numeric_columns = [
    "SeniorCitizen", "tenure", "MonthlyCharges", "TotalCharges"
]
for col in numeric_columns:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")
print("\nData types after conversion:\n", df.dtypes)
# Algorithm Step 6: Remove records with missing churn labels
df = df[df["Churn"].isin(["yes", "no"])].copy()
# Create target variable: Yes = 1, No = 0
df["Churn"] = df["Churn"].map({"no": 0, "yes": 1}).astype(int)
print("\nChurn distribution:\n", df["Churn"].value_counts())
# Algorithm Step 7: Create additional customer features
# Group customers according to their tenure
df["Tenure Group"] = pd.cut(
    df["tenure"],
    bins=[-1, 12, 24, 48, float("inf")],
    labels=["New", "Medium", "Long", "Loyal"]
)
# Calculate average charges per tenure month
df["Average Charge Per Tenure Month"] = (
    df["TotalCharges"] / df["tenure"].replace(0, np.nan)
)
# For zero-tenure or missing calculations, use MonthlyCharges
df["Average Charge Per Tenure Month"] = (
    df["Average Charge Per Tenure Month"].fillna(df["MonthlyCharges"])
)
print("\nNew features created:")
print(df[[
    "tenure", "Tenure Group",
    "Average Charge Per Tenure Month"
]].head())
# Algorithm Step 8: Separate input features and target variable
# Remove customer ID because it is an identifier, not a useful predictor
X = df.drop(columns=["Churn", "customerID"], errors="ignore")
y = df["Churn"]
# Split before fitting preprocessing steps to prevent data leakage
X_train, X_test, y_train, y_test = train_test_split(
    X, y,
    test_size=0.20,
    random_state=42,
    stratify=y
)
print("\nTraining samples:", X_train.shape[0])
print("Testing samples:", X_test.shape[0])
# Algorithm Step 9: Identify numeric and categorical columns
num_cols = X_train.select_dtypes(include=np.number).columns.tolist()
cat_cols = X_train.select_dtypes(
    include=["object", "category", "string"]
).columns.tolist()
# Algorithm Step 10: Handle missing numeric values using training medians
for col in num_cols:
    median_value = X_train[col].median()
    if pd.isna(median_value):
        median_value = 0
    X_train[col] = X_train[col].fillna(median_value)
    X_test[col] = X_test[col].fillna(median_value)
# Algorithm Step 11: Detect and cap numeric outliers using IQR
for col in num_cols:
    q1 = X_train[col].quantile(0.25)
    q3 = X_train[col].quantile(0.75)
    iqr = q3 - q1
    lower_limit = q1 - 1.5 * iqr
    upper_limit = q3 + 1.5 * iqr
    X_train[col] = X_train[col].clip(lower_limit, upper_limit)
    X_test[col] = X_test[col].clip(lower_limit, upper_limit)
# Algorithm Step 12: Handle missing categorical values
for col in cat_cols:
    modes = X_train[col].mode()
    fill_value = modes.iloc[0] if not modes.empty else "unknown"
    X_train[col] = X_train[col].fillna(fill_value)
    X_test[col] = X_test[col].fillna(fill_value)
# Algorithm Step 13: Convert categorical features into numeric columns
X_train = pd.get_dummies(X_train, drop_first=True, dtype=int)
X_test = pd.get_dummies(X_test, drop_first=True, dtype=int)
# Ensure training and testing have identical feature columns
X_test = X_test.reindex(columns=X_train.columns, fill_value=0)
# Algorithm Step 14: Standardize numeric features
# Fit the scaler only on training data
scale_cols = [col for col in num_cols if col in X_train.columns]
scaler = StandardScaler()
if scale_cols:
    X_train[scale_cols] = scaler.fit_transform(X_train[scale_cols])
    X_test[scale_cols] = scaler.transform(X_test[scale_cols])
print("\nNumber of input features:", X_train.shape[1])
print("\nScaled training data:\n", X_train.head())
print("\nScaled testing data:\n", X_test.head())
# Algorithm Step 15: Combine features and target labels
train_df = X_train.copy()
train_df["Churn"] = y_train
test_df = X_test.copy()
test_df["Churn"] = y_test
# Algorithm Step 16: Save all output datasets
# Save files in a folder inside the current working directory
output_dir = os.path.abspath("Telecom_churn")
os.makedirs(output_dir, exist_ok=True)
cleaned_path = os.path.join(output_dir, "cleaned_churn.csv")
train_path = os.path.join(output_dir, "train_data.csv")
test_path = os.path.join(output_dir, "test_data.csv")
df.to_csv(cleaned_path, index=False)
train_df.to_csv(train_path, index=False)
test_df.to_csv(test_path, index=False)
# Algorithm Step 17: Display final results
print("\nFINAL RESULTS")
print("-" * 45)
print("Cleaned dataset shape:", df.shape)
print("Training dataset shape:", train_df.shape)
print("Testing dataset shape:", test_df.shape)
print("Missing values in training data:", X_train.isnull().sum().sum())
print("Missing values in testing data:", X_test.isnull().sum().sum())
print("Duplicate records remaining:", df.duplicated().sum())
print("\nTraining churn distribution:\n", y_train.value_counts())
print("\nTesting churn distribution:\n", y_test.value_counts())
print("\nAll output files saved successfully:")
print("1.", cleaned_path)
print("2.", train_path)
print("3.", test_path)
