# 1. Import required libraries
import pandas as pd
import matplotlib.pyplot as plt
# 2. Load the air quality dataset using a direct file path
df = pd.read_csv(r"C:\Users\Dell\Downloads\AirQuality.csv")
# 3. Explore the dataset
print("DATASET LOADED SUCCESSFULLY")
print("\nFirst five rows:")
print(df.head())
print("\nDataset shape:", df.shape)
print("\nColumn names:", df.columns.tolist())
print("\nDataset information:")
df.info()
print("\nStatistical summary:")
print(df.describe(include="all"))
print("\nMissing values:")
print(df.isnull().sum())
# 4. Convert dates and filter data for the selected city
df["Date"] = pd.to_datetime(df["Date"], errors="coerce")
selected_city = "Amritsar"
city_df = df[df["City"].str.strip().str.lower() == selected_city.lower()].copy()
city_df["Date"] = pd.to_datetime(city_df["Date"], errors="coerce")
if city_df.empty:
    print("\nCity not found. Available cities:")
    print(df["City"].dropna().unique())
else:
    # 5. Convert AQI and pollutant columns to numeric values
    pollutants = ["PM2.5", "PM10", "CO"]
    pollutants = [col for col in pollutants if col in city_df.columns]
    for col in ["AQI"] + pollutants:
        if col in city_df.columns:
            city_df[col] = pd.to_numeric(city_df[col], errors="coerce")
    city_df.dropna(subset=["Date"], inplace=True)
    city_df.sort_values("Date", inplace=True)
    # 6. Plot the overall daily AQI trend
    aqi_data = city_df.dropna(subset=["AQI"])
    plt.figure(figsize=(12, 5))
    plt.plot(
        aqi_data["Date"], aqi_data["AQI"],
        color="blue", linewidth=1.5, label="Daily AQI"
    )
    plt.title(f"Daily AQI Trend in {selected_city}")
    plt.xlabel("Date")
    plt.ylabel("Air Quality Index (AQI)")
    plt.legend()
    plt.grid(True, alpha=0.3)
    plt.gcf().autofmt_xdate()
    plt.tight_layout()
    plt.show()
    # 7. Plot each pollutant trend separately
    for pollutant in pollutants:
        pollutant_data = city_df.dropna(subset=[pollutant])
        plt.figure(figsize=(12, 5))
        plt.plot(
            pollutant_data["Date"], pollutant_data[pollutant],
            linewidth=1.2, label=pollutant
        )
        plt.title(f"{pollutant} Trend in {selected_city}")
        plt.xlabel("Date")
        plt.ylabel(f"{pollutant} Level")
        plt.legend()
        plt.grid(True, alpha=0.3)
        plt.gcf().autofmt_xdate()
        plt.tight_layout()
        plt.show()
    # 8. Calculate and plot monthly average AQI
    monthly_data = city_df.dropna(subset=["AQI"]).copy()
    monthly_data["YearMonth"] = monthly_data["Date"].dt.to_period("M")
    monthly_aqi = monthly_data.groupby("YearMonth")["AQI"].mean()
    plt.figure(figsize=(14, 6))
    plt.bar(
        monthly_aqi.index.astype(str),
        monthly_aqi.values,
        label="Average AQI"
    )
    plt.title(f"Monthly Average AQI in {selected_city}")
    plt.xlabel("Year-Month")
    plt.ylabel("Average AQI")
    plt.xticks(rotation=90)
    plt.legend()
    plt.grid(axis="y", alpha=0.3)
    plt.tight_layout()
    plt.show()
    # 9. Analyze AQI distribution by AQI category using a box plot
    if "AQI_Bucket" in city_df.columns:
        box_data = city_df.dropna(subset=["AQI", "AQI_Bucket"])
        categories = sorted(box_data["AQI_Bucket"].unique())
        values_by_category = [
            box_data.loc[box_data["AQI_Bucket"] == category, "AQI"].values
            for category in categories
        ]
        if categories:
            plt.figure(figsize=(12, 6))
            plt.boxplot(values_by_category, labels=categories)
            plt.title(f"AQI Distribution by AQI Category in {selected_city}")
            plt.xlabel("AQI Category")
            plt.ylabel("Air Quality Index (AQI)")
            plt.xticks(rotation=30)
            plt.grid(axis="y", alpha=0.3)
            plt.tight_layout()
            plt.show()
    # 10. Create scatter plots to compare AQI with each pollutant
    for pollutant in pollutants:
        scatter_data = city_df.dropna(subset=["AQI", pollutant])
        plt.figure(figsize=(8, 5))
        plt.scatter(
            scatter_data[pollutant],
            scatter_data["AQI"],
            alpha=0.5,
            label=pollutant
        )
        plt.title(f"AQI vs {pollutant} in {selected_city}")
        plt.xlabel(f"{pollutant} Level")
        plt.ylabel("Air Quality Index (AQI)")
        plt.legend()
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.show()
    # 11. Display AQI and pollutant statistics
    print(f"\nAQI Summary for {selected_city}")
    print(f"Average AQI: {city_df['AQI'].mean():.2f}")
    print(f"Maximum AQI: {city_df['AQI'].max():.2f}")
    print(f"Minimum AQI: {city_df['AQI'].min():.2f}")
    print("\nAverage pollutant levels:")
    print(city_df[pollutants].mean())
    # 12. Calculate correlations between AQI and pollutant levels
    print("\nCorrelation between AQI and pollutant levels:")
    print(city_df[["AQI"] + pollutants].corr())
